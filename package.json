{
  "name": "dsh-team-janitor",
  "version": "1.1.5",
  "type": "module",
  "description": "Team collaboration QoL for DeepSeek Harness: the agent can close subagents it is done with — model-facing close/sweep/overview/restore tools, reversible archiving, subtree-scoped, last-words roster, and a per-conversation red 'cleared' marker in the Web subagent menu.",
  "author": "xian-yu-zhao",
  "license": "MIT",
  "homepage": "https://github.com/xian-yu-zhao/dsh-team-janitor#readme",
  "bugs": {
    "url": "https://github.com/xian-yu-zhao/dsh-team-janitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xian-yu-zhao/dsh-team-janitor.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "subagent",
    "agent-teams",
    "agent-tool",
    "lifecycle"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client.js",
    "locale/",
    "docs/",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "cordis.patch.yml",
    "package.json"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check client.js",
    "test": "node test/smoke.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-subagent"
      ]
    }
  }
}
